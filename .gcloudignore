# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore, with the addition of
# "#!include" directives.

# Include .gitignore rules
#!include:.gitignore

# Exclude node_modules (will be installed during build)
node_modules/

# Exclude local development files
.env
.env.local
.env.*.local

# Exclude IDE files
.idea/
.vscode/
*.swp
*.swo

# Exclude test files
coverage/
.nyc_output/

# Exclude build output
.next/
out/

# Exclude reference docs (too large)
reference/
.external-build/
